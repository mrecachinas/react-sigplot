{
  "name": "react-sigplot",
  "description": "React wrapper for SigPlot",
  "version": "1.0.0",
  "homepage": "https://github.com/lgsinnovations/react-sigplot",
  "author": {
    "name": "LGS Innovations",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgsinnovations/react-sigplot.git"
  },
  "bugs": {
    "url": "https://github.com/lgsinnovations/react-sigplot/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/react-sigplot.umd.js",
  "module": "./dist/react-sigplot.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/react-sigplot.es.js",
      "require": "./dist/react-sigplot.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsgo",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "sigplot": "^2.0.0-rc20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^2.11.2",
    "jest-canvas-mock": "^2.5.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-canvas-mock": "^1.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
