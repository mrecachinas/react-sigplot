{
  "name": "react-sigplot",
  "description": "React wrapper for SigPlot",
  "version": "1.0.0",
  "homepage": "https://github.com/lgsinnovations/react-sigplot",
  "author": {
    "name": "LGS Innovations",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgsinnovations/react-sigplot.git"
  },
  "bugs": {
    "url": "https://github.com/lgsinnovations/react-sigplot/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/react-sigplot.umd.js",
  "module": "./dist/react-sigplot.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/react-sigplot.es.js",
      "require": "./dist/react-sigplot.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "clean": "rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "sigplot": "^2.0.0-rc20"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "canvas": "^2.11.2",
    "jest-canvas-mock": "^2.5.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vitest-canvas-mock": "^1.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
